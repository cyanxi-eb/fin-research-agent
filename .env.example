# 容器/服务形态的变量文件模板 —— 复制成 .env 再填真值（.env 已 gitignore）
#   cp .env.example .env
#
# 本机裸跑请改用 data/llm_keys.local.json + data/db_keys.local.json（免设环境变量），见 README。

# ---- LLM 通道 ----
LLM_ACTIVE=deepseek
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# 私有化断网演示：切本地模型（Ollama / vLLM）
# LLM_ACTIVE=local
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1

# ---- 数据源 ----
# 取数接口有反爬策略，改这里即可，不必进代码
CNINFO_UA=Mozilla/5.0 (compatible; fin-research-agent/0.1)
# 每次请求间隔（秒），别调太小，会被限流
FETCH_INTERVAL=1.5

# ---- 检索 ----
# Step 1 只用 BM25；Step 4 起再启用向量与重排
RETRIEVE_MODE=bm25          # bm25 | hybrid
RETRIEVE_TOPK=5

# ---- 数据源后端（Step 2 起启用）----
# sqlite（零依赖）| mysql
# 容器形态（docker compose）默认走 mysql；纯 SQLite 容器：FA_DB_BACKEND=sqlite docker compose up -d app --no-deps
FA_DB_BACKEND=mysql
# ⚠️ 容器里 MYSQL_HOST 必须是 compose 的服务名 `web-db`（不是 127.0.0.1）：
#    填 127.0.0.1 时 app 容器会去连「它自己」而不是数据库容器 → 连不上库。
MYSQL_HOST=web-db
MYSQL_PORT=3306
MYSQL_USER=agent
MYSQL_PASSWORD=
MYSQL_DATABASE=fin_research
# 仅 compose 的 web-db 容器用；留空则用 docker-compose.yml 里的占位默认值。
# 注意：这些只在 mysql 数据卷**首次创建**时生效，卷已存在时改这里无效 → 需 `docker compose down -v`。
MYSQL_ROOT_PASSWORD=

# ---- 鉴权（JWT）----
# 默认开启：业务端点（/api/ask、/api/compare、/api/audit…）一律要 Bearer token。
FA_AUTH_ENABLED=1
# ⚠️ 必填真值：留空且 FA_AUTH_ENABLED=1 时**服务启动即失败**（这是刻意的安全默认，
#    用默认密钥签名等于没鉴权）。生成一个随机长串：
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
FA_JWT_SECRET=
# 可选：access/refresh token 有效期（分钟 / 天）
# FA_JWT_ACCESS_TTL_MIN=120
# FA_JWT_REFRESH_TTL_DAYS=7
# 首次启动按下面两项建出演示账号（幂等：账号已存在则不覆盖口令）。
# 口令留空则不建号；口令短于 8 位同样不建号并打印提示。
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=
# 纯单机演示、完全不要登录门面：FA_AUTH_ENABLED=0（前端显示「单机模式（免登录）」）

# ---- 联网搜索兜底（库中查不到时自动去网上找；≥2 个独立域名交叉验证一致才展示并入库）----
FA_WEB_SEARCH_ENABLED=1
# 免 Key 通道：bing（默认，国内可达）| ddg（装了 duckduckgo-search 更稳，海外网络合用）
FA_WEB_SEARCH_BACKEND=bing
# 仅切到 tavily 通道时才填真实 Key；免 Key 的 bing/ddg 通道留空即可
TAVILY_API_KEY=
# 配额与规模（默认值一般够用，可按需覆盖）
# FA_WEB_SEARCH_MAX_RESULTS=5
# FA_WEB_SEARCH_MAX_PAGES=3
# FA_WEB_SEARCH_DAILY_QUOTA=200
# FA_WEB_SEARCH_MIN_DOMAINS=2

# ---- 构建期 pip 源（内网/慢网可换）----
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ---- Phase 2: 向量后端切换 ----
# numpy（默认，零依赖）| qdrant（向量数据库）
# 切 qdrant 时 compose 要带 profile：docker compose --profile qdrant up -d
FA_VECTOR_BACKEND=numpy
# 切 qdrant 时才需要；compose 网络里主机名就是服务名
FA_QDRANT_URL=http://qdrant:6333
FA_QDRANT_COLLECTION=fin_research_vectors

# ---- Phase 3: 治理横切 ----
# 速率限制（auth 5/min, ingest 3/min, ask 15/min）
FA_RATE_LIMIT_ENABLED=1
# 结构化日志（1=JSON 格式；0=plain 人类可读）
FA_STRUCTURED_LOGGING=1
# 响应信封 {code, msg, data, trace_id}（1=ON；0=OFF 零侵入）
FA_RESPONSE_ENVELOPE=1

# ---- Phase 4: 部署端口覆盖 ----
APP_PORT=8000
NGINX_PORT=80
# Grafana 首次启动 admin 密码（之后持久化到 grafana-data 卷）
GRAFANA_ADMIN_PASSWORD=finresearch
